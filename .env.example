# Public app origin used in invite and password-reset emails.
NEXT_PUBLIC_APP_URL=https://tracker.maayasoft.in

# Supabase — project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Invite actions, admin roster lookup, RLS test fixtures,
# and the morning-note cron (opted-in members' own rows).
# Never import into a client component or a module a client can reach.
SUPABASE_SECRET_KEY=

# Morning note. Resend + a from-address you own. Cron secret is what
# Vercel sends as Authorization: Bearer … each hour.
RESEND_API_KEY=
MORNING_NOTE_FROM=Holistic Growth Tracker <notes@your-domain>
CRON_SECRET=
